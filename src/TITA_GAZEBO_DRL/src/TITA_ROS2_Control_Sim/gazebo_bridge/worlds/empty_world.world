<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- 提供 /set_entity_state 与 /get_entity_state 服务 (模型位姿重置用) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
  </world>
</sdf>